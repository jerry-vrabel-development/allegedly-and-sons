{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allegedly-and-sons",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // The shop's own domain. Cloudflare creates the DNS record and certificate on
  // deploy. It's the only public address: the workers.dev address and preview
  // URLs are off, so links, search results and analytics all point one place.
  "routes": [{ "pattern": "allegedlyandsons.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Orders and processed Stripe events (design note 0004). Schema lives in
  // migrations/; apply with `npx wrangler d1 migrations apply DB --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "allegedly-and-sons",
      "database_id": "cbe53d82-8709-4a40-90c8-d5defc600fae",
      "migrations_dir": "migrations",
    },
  ],
  // Public config, safe to commit. The publishable key is meant to be in pages;
  // it only lets Stripe.js mount the embedded checkout. Sandbox key for now.
  "vars": {
    "STRIPE_PUBLISHABLE_KEY": "pk_test_51OouIEIW6zj6eT7dhtWNnMeRy5DLAIuho1m7RhUuHgtcHJKtOX1Pnxlhrd9jHY8acsRljHpNvS9Bb5YLah3SIg6l004BAftm0Y",
  },
  "observability": {
    "enabled": true,
  },
}
