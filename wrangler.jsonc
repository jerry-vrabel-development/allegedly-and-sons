{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allegedly-and-sons",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // The shop's own domain. Cloudflare creates the DNS record and certificate on
  // deploy. It's the only public address: the workers.dev address and preview
  // URLs are off, so links, search results and analytics all point one place.
  "routes": [{ "pattern": "allegedlyandsons.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
}
